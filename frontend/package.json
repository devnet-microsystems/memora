{
  "name": "memora-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "build:app": "tsc --noEmit && vite build --config vite.app.config.ts",
    "dev:app": "vite --config vite.app.config.ts"
  },
  "dependencies": {
    "3d-force-graph": "^1.74.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.186.1",
    "three-spritetext": "^1.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.2.1",
    "playwright": "^1.64.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
